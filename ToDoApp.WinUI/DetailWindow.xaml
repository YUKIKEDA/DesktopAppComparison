<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ToDoApp.WinUI.DetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="アイテム詳細">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24" RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="16" MaxWidth="560">
                <TextBox
                    x:Name="TitleTextBox"
                    Header="タイトル"
                    PlaceholderText="タイトル *" />
                <TextBox
                    x:Name="DescriptionTextBox"
                    Header="説明"
                    AcceptsReturn="True"
                    MaxHeight="120"
                    PlaceholderText="説明"
                    ScrollViewer.VerticalScrollMode="Auto"
                    TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="ステータス" />
                        <ComboBox x:Name="StatusComboBox" HorizontalAlignment="Stretch">
                            <x:String>未着手</x:String>
                            <x:String>進行中</x:String>
                            <x:String>完了</x:String>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="優先度" />
                        <ComboBox x:Name="PriorityComboBox" HorizontalAlignment="Stretch">
                            <x:String>低</x:String>
                            <x:String>中</x:String>
                            <x:String>高</x:String>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="期限" />
                    <DatePicker x:Name="DueDatePicker" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="ID" Opacity="0.7" />
                    <TextBlock x:Name="IdTextBlock" Opacity="0.7" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="1"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button Click="CancelButton_Click" Content="閉じる" />
            <Button
                Click="SaveButton_Click"
                Content="保存"
                Style="{ThemeResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
