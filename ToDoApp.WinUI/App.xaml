<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ToDoApp.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ToDoApp.WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppFilterBarBrush" Color="#F9FAFB" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#E5E7EB" />
                    <SolidColorBrush x:Key="AppRowHoverBrush" Color="#EFF6FF" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="AppDangerBrush" Color="#DC2626" />
                    <SolidColorBrush x:Key="AppOnAccentBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#111827" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#1F2937" />
                    <SolidColorBrush x:Key="AppFilterBarBrush" Color="#1F2937" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#374151" />
                    <SolidColorBrush x:Key="AppRowHoverBrush" Color="#1E3A5F" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="AppDangerBrush" Color="#DC2626" />
                    <SolidColorBrush x:Key="AppOnAccentBrush" Color="#FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="BrandAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource AppAccentBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource AppOnAccentBrush}" />
            </Style>
            <Style x:Key="BrandDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource AppDangerBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource AppOnAccentBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
