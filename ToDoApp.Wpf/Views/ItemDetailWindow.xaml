<Window
    x:Class="ToDoApp.Wpf.Views.ItemDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="アイテム詳細"
    Width="520"
    Height="520"
    MinWidth="400"
    MinHeight="400"
    Background="#F3F4F6"
    Opacity="0.95"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Border Padding="24" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,16"
                FontSize="18"
                FontWeight="Bold"
                Text="アイテムを編集" />
            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontWeight="SemiBold"
                        Text="タイトル *" />
                    <TextBox
                        Margin="0,0,0,16"
                        Padding="8,6"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        MaxLength="200"
                        Text="{Binding EditingItem.Title, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="0,0,0,4"
                        FontWeight="SemiBold"
                        Text="説明" />
                    <TextBox
                        MinHeight="80"
                        Margin="0,0,0,16"
                        Padding="8,6"
                        AcceptsReturn="True"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        MaxLength="500"
                        Text="{Binding EditingItem.Description, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                FontWeight="SemiBold"
                                Text="ステータス" />
                            <ComboBox
                                Padding="8,6"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                SelectedValue="{Binding EditingItem.Status}"
                                SelectedValuePath="Content">
                                <ComboBoxItem Content="未着手" />
                                <ComboBoxItem Content="進行中" />
                                <ComboBoxItem Content="完了" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                FontWeight="SemiBold"
                                Text="優先度" />
                            <ComboBox
                                Padding="8,6"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                SelectedValue="{Binding EditingItem.Priority}"
                                SelectedValuePath="Content">
                                <ComboBoxItem Content="低" />
                                <ComboBoxItem Content="中" />
                                <ComboBoxItem Content="高" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontWeight="SemiBold"
                        Text="期限" />
                    <DatePicker
                        Margin="0,0,0,16"
                        Padding="8,6"
                        SelectedDate="{Binding EditingItem.DueDate}" />
                </StackPanel>
            </ScrollViewer>
            <StackPanel
                Grid.Row="2"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Padding="12,6"
                    Command="{Binding CancelCommand}"
                    Content="キャンセル" />
                <Button
                    Padding="12,6"
                    Background="#2563EB"
                    BorderThickness="0"
                    Command="{Binding SaveCommand}"
                    Content="保存"
                    Foreground="White" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
