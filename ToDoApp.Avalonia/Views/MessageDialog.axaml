<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ToDoApp.Avalonia.Views.MessageDialog"
        x:DataType="views:MessageDialog"
        xmlns:views="using:ToDoApp.Avalonia.Views"
        Title="Message"
        Width="400"
        Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SizeToContent="Height">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                Text="{Binding Message, Mode=OneWay}"
                TextWrapping="Wrap"
                VerticalAlignment="Center" />
        <StackPanel Grid.Row="1"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
            <Button Name="PrimaryButton"
                    Margin="0,0,8,0"
                    Padding="12,6"
                    Content="{Binding PrimaryButtonText, Mode=OneWay}"
                    IsDefault="True" />
            <Button Name="SecondaryButton"
                    Padding="12,6"
                    Content="{Binding SecondaryButtonText, Mode=OneWay}"
                    IsVisible="{Binding HasSecondaryButton, Mode=OneWay}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>

